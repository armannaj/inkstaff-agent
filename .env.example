# Copy to .env.local and fill in. Only the first block is required; everything else has a default.

# --- Required ------------------------------------------------------------------------------------------------------
# Every model call (agents, vision, images, embeddings): https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Google and YouTube results and keyword data: https://app.dataforseo.com/api-access
# Either the Basic auth value (base64 of login:password), or the login and password; DFS_AUTH wins when both are set.
DFS_AUTH=

# --- Optional services ---------------------------------------------------------------------------------------------
# Screenshots of web pages, and reading pages drawn by JavaScript: https://screenshotengine.com
SCREENSHOTENGINE_API_KEY=
# Google Search Console data for the product's site: the path to a service account's JSON key file. Add the service
# account as a user on each Search Console property it should read.
GSC_CREDENTIALS_PATH=

# --- Storage -------------------------------------------------------------------------------------------------------
# The SQLite database file, created on first use.
DATABASE_PATH=data/inkstaff.db

# --- Market --------------------------------------------------------------------------------------------------------
# DataForSEO location and language codes (2840 = United States): https://docs.dataforseo.com/v3/serp/google/locations/
DATAFORSEO_LOCATION_CODE=2840
DATAFORSEO_LANGUAGE_CODE=en

# --- Models (OpenRouter ids, https://openrouter.ai/models) ----------------------------------------------------------
# Agents must support tool calling.
MODEL_DIRECTOR=openai/gpt-6.1-sol
MODEL_RESEARCH=openai/gpt-6-luna-pro
MODEL_EDITOR=openai/gpt-6.1-sol
MODEL_WRITER=openai/gpt-6.1-sol
MODEL_GRAPHICS=openai/gpt-6-luna-pro
MODEL_REVIEWER=anthropic/claude-sonnet-5.5
# Looks at images; must accept image inputs. Defaults to MODEL_GRAPHICS.
MODEL_VISION=
# Summarizes your site's pages when they are indexed. Defaults to MODEL_RESEARCH.
MODEL_SITE_SUMMARY=
# Reasoning effort per agent: low, medium or high.
EFFORT_DIRECTOR=medium
EFFORT_RESEARCH=medium
EFFORT_EDITOR=high
EFFORT_WRITER=medium
EFFORT_GRAPHICS=low
EFFORT_REVIEWER=high
# Send each turn's reasoning back to the model on the agent's next turn.
REASONING_PASSBACK=true
# Draws illustrations, infographics and covers, with model-specific options as JSON.
IMAGE_MODEL=openai/gpt-image-2.5-flare
IMAGE_OPTIONS={"quality":"high"}
# Embeds your site's pages for internal links. Changing it means indexing the site again.
EMBEDDING_MODEL=openai/text-embedding-3-small

# --- Limits per article --------------------------------------------------------------------------------------------
# Hard spending stop per article, in USD.
ARTICLE_BUDGET_USD=15
# Articles written at the same time; the rest wait in the queue.
AGENT_CONCURRENCY=2
MAX_REVIEW_ROUNDS=3
MAX_DIRECTOR_TURNS=40
MAX_TURNS_RESEARCH=30
MAX_TURNS_EDITOR=20
MAX_TURNS_WRITER=40
MAX_TURNS_GRAPHICS=30
MAX_TURNS_REVIEWER=20
MAX_SEARCHES=15
MAX_READS=25
MAX_VIDEO_SEARCHES=5
MAX_TRANSCRIPTS=10
MAX_PAID_DATA_CALLS=4
PAID_DATA_BUDGET_USD=0.1
MAX_IMAGES=10
MAX_SCREENSHOTS=15

# --- Site index ----------------------------------------------------------------------------------------------------
SITE_INDEX_MAX_PAGES=200
